# Copy this file to .env (Expo SDK 57 inlines EXPO_PUBLIC_* vars at build time)

# Public URL of a deployed backend (recommended for release builds)
EXPO_PUBLIC_API_BASE=https://your-backend-host.example.com

# Or point at a backend running on your dev machine for emulator testing
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000
